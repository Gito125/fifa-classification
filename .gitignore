.venv/
env/
venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System
.DS_Store
Thumbs.db

# Large Raw Data (keep directory structure tracked via .gitkeep)
data/raw/*
!data/raw/.gitkeep
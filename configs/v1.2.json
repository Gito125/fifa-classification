{
  "model_version": "v1.2",
  "description": "Multi-season temporal validation: Train on FIFA 15-20, Test on unseen FIFA 21",
  "paths": {
    "processed_dir": "data/processed/v1.2",
    "models_dir": "models/v1.2",
    "figures_dir": "figures/v1.2",
    "config_file": "configs/v1.2.json"
  },
  "data_sources": {
    "split_strategy": "by_files",
    "train_files": [
      "data/raw/players_15.csv",
      "data/raw/players_16.csv",
      "data/raw/players_17.csv",
      "data/raw/players_18.csv",
      "data/raw/players_19.csv",
      "data/raw/players_20.csv"
    ],
    "test_files": [
      "data/raw/players_21.csv"
    ]
  },
  "preprocessing": {
    "age_range": [16, 40],
    "features": {
      "include_height_weight": true,
      "include_preferred_foot": true,
      "include_work_rate": true,
      "include_body_type": true,
      "include_international_reputation": true,
      "include_player_traits": true
    }
  },
  "best_params": {}
}
